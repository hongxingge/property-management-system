<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.manage.mapper.CarportMapper">


    <select id="getCarport" resultType="CarportBean">
        SELECT *
        FROM carport
    </select>

    <select id="getCarportByNumber" resultType="CarportBean">
        SELECT *
        FROM carport WHERE  number=#{number}
    </select>


    <insert id="addCarport" parameterType="CarportBean">
        INSERT INTO carport (number, type, remark)
        VALUES (#{number}, #{type}, #{remark})
    </insert>


    <delete id="deleteCarport">
        DELETE
        FROM carport
        WHERE id = #{id}
    </delete>


    <update id="updateCarport" parameterType="carportBean">
        UPDATE carport
        SET number = #{number},
            type   = #{type},
            remark = #{remark}
        WHERE id = #{id}
    </update>

</mapper>
