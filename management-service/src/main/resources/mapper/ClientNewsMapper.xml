<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.manage.mapper.ClientNewsMapper">

    <insert id="addNews" parameterType="ClientNewsBean">
        INSERT INTO client_news (title, content, time)
        VALUES (#{title}, #{content}, #{time})
    </insert>

    <update id="updateNews" parameterType="ClientNewsBean">
        UPDATE client_news
        SET title   = #{title},
            content = #{content},
            time    = #{time}
        WHERE id = #{id}
    </update>

    <select id="getNews" resultType="ClientNewsBean">
        SELECT id, title, time
        FROM client_news
    </select>

    <select id="getNewsById"   resultType="ClientNewsBean">
        SELECT *
        FROM client_news
        WHERE id = #{id}
    </select>


    <delete id="deleteNews"  >
        DELETE
        FROM client_news
        WHERE id = #{id}
    </delete>
</mapper>
