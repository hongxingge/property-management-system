<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.manage.mapper.KnowledgeDocumentMapper">

    <insert id="insertDocument" parameterType="com.example.manage.bean.KnowledgeDocumentBean"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO knowledge_document (title, content, status, created_at)
        VALUES (#{title}, #{content}, #{status}, #{createdAt})
    </insert>

    <delete id="deleteDocument">
        DELETE FROM knowledge_document WHERE id = #{id}
    </delete>

    <select id="listDocuments" resultType="com.example.manage.bean.KnowledgeDocumentBean">
        SELECT * FROM knowledge_document ORDER BY created_at DESC
    </select>
</mapper>