    <delete id="deleteRoomUserById" parameterType="string">
        DELETE
        FROM room_user
        WHERE id = #{id}
    </delete>
    <!--    VALUES (#{id}, #{name}, #{sex}, #{idCard}, #{phone}, #{creator}, #{roomNumber}, #{age})-->
    <update id="updateRoomUserById" parameterType="roomUserBean">
        UPDATE room_user
        SET name   = #{name},
            sex=#{sex},
            id_card=#{idCard},
            phone  = #{phone},
            room_number  = #{roomNumber},
            age    = #{age}
        WHERE id = #{id}
    </update>

    <update id="updatePwd" parameterType="roomUserBean">
        UPDATE room_user
        SET pwd  = #{uPwd}
        WHERE  phone=#{phone}
    </update>
</mapper>
