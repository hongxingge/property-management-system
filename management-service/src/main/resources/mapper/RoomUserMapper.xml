<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.manage.mapper.RoomUserMapper">


    <insert id="addRoomUser" parameterType="roomUserBean">
        INSERT INTO room_user (id, name, sex, id_card, phone, creator, room_number, age,pwd)
        VALUES (#{id}, #{name}, #{sex}, #{idCard}, #{phone}, #{creator}, #{roomNumber}, #{age}, #{pwd})
    </insert>

    <select id="queryRoomUser" parameterType="string" resultType="roomUserBean">
        SELECT *
        FROM room_user
    </select>

    <select id="getRoomUserById" parameterType="string" resultType="roomUserBean">
        SELECT *
        FROM room_user WHERE id=#{id}
    </select>

    <select id="getRoomUserByPhone" parameterType="string" resultType="roomUserBean">
        SELECT *
        FROM room_user WHERE phone=#{phone}
    </select>

    <select id="queryRoomUserByCondition" parameterType="string" resultType="roomUserBean">
        SELECT *
        FROM room_user
        WHERE name LIKE concat('%',#{condition},'%') or
        phone LIKE concat('%',#{condition},'%')
    </select>

